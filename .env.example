# Salin ke .env.local untuk development, dan isi di Vercel → Settings → Environment Variables untuk deploy.

# WAJIB di production. Rahasia penandatangan cookie sesi, minimal 32 karakter acak.
# Buat dengan: openssl rand -base64 48
AUTH_SECRET=

# Login demo (3 akun contoh: Free / Premium / Admin).
# Development: aktif otomatis. Production: MATI kecuali diisi "true".
# JANGAN aktifkan untuk pengguna nyata: siapa pun bisa memilih akun Admin.
DEMO_AUTH=true
